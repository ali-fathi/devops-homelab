# TEMPLATE ONLY — do not apply until the Synology export and node mount probe pass.
#
# Generate the live BackupTarget with:
# ./scripts/configure-longhorn-synology-nfs-backup-target.sh --server 192.168.178.120 --export /srv/longhorn_backups --confirm
#
# This file intentionally has a .template extension and is not GitOps- or
# Terraform-managed. It contains no credentials because NFS uses export access
# control on the Synology NAS.
apiVersion: longhorn.io/v1beta2
kind: BackupTarget
metadata:
  name: default
  namespace: longhorn-system
spec:
  backupTargetURL: "nfs://192.168.178.120:/srv/longhorn_backups"
  credentialSecret: ""
  pollInterval: "300s"
